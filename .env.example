# Copy this file to .env and fill in real values. Never commit .env.
# PostgreSQL running in Docker (same server DBeaver connects to)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=urban_pulse_db

# Hosted database (for example Neon): use its host name and user, and add SSL
# DB_HOST=<host name from the provider>
# DB_USER=<user from the provider>
# DB_NAME=<database name from the provider>
# PGSSLMODE=require

# Optional: free Socrata app token (raises API rate limits)
SOCRATA_APP_TOKEN=
